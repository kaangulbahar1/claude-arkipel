# Supabase projesi > Settings > API
SUPABASE_URL=https://xxxx.supabase.co
# Sadece sunucu tarafında kullanılır; tarayıcıya asla gönderilmez.
SUPABASE_SERVICE_ROLE_KEY=

# Gönderim sınırı için IP hash tuzu. Uzun, rastgele bir değer: `openssl rand -hex 32`
IP_HASH_SALT=

# /panel sayfasının şifresi. Uzun, rastgele bir değer: `openssl rand -hex 24`
PANEL_PASSWORD=

# Paylaşım görselleri ve bağlantılar için sitenin adresi
NEXT_PUBLIC_SITE_URL=https://arkipel.app

# Gizlilik sayfasında görünen veri sorumlusu (ad soyad ya da şirket unvanı) ve başvuru e-postası
NEXT_PUBLIC_DATA_CONTROLLER=
NEXT_PUBLIC_CONTACT_EMAIL=
